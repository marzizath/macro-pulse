# Copy to backend/.env for local dev. In GitHub Actions, set these as
# repository secrets instead (Settings -> Secrets and variables -> Actions).

# --- Splitwise (secure.splitwise.com/apps) ---
SPLITWISE_API_KEY=

# --- Basiq (basiq.io) ---
BASIQ_API_KEY=
BASIQ_USER_ID=

# 'fixture' replays backend/tests/fixtures/bank_sample.json - use this until
# Basiq sandbox/production credentials are wired up. Switch to 'basiq' once ready.
DATA_SOURCE=fixture

# --- App / API ---
# Bearer token the frontend sends as `Authorization: Bearer <APP_SECRET>`.
# Leave blank for local dev (auth is skipped when unset).
APP_SECRET=
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Defaults to <repo>/data/ledger.db - override only if you need a different path.
# DATABASE_PATH=/data/ledger.db

# --- Email digest (reuses the Macro Pulse Gmail app-password setup) ---
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Telegram nudge (reuses the Macro Pulse bot) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
